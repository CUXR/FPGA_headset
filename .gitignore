.vscode
.DS_Store

__pycache__/
.pytest_cache/
python/output/
sim/

# Vivado project: keep only the .xpr
vivado/project/*
!vivado/project/*.xpr

# Block designs (one folder per design in vivado/bd/):
# keep the design, its layout and each IP's settings; Vivado regenerates the rest
vivado/bd/*/*
!vivado/bd/*/*.bd
!vivado/bd/*/*.bda
!vivado/bd/*/ui/
!vivado/bd/*/ip/
vivado/bd/*/ip/*/*
!vivado/bd/*/ip/*/*.xci

# Vivado scratch files
.Xil/
*.jou
*.log
*.str